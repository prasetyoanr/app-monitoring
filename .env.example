# PostgreSQL connection used by the Next.js server and Drizzle Kit.
DATABASE_URL=postgresql://app_monitoring:change-me@localhost:5432/app_monitoring

# 32-byte base64url key used to encrypt Synology passwords at rest.
# Generate once and keep the same value when deploying or restoring backups.
BACKUP_CREDENTIAL_ENCRYPTION_KEY=

# Optional. Used by `bun run db:create-admin`; omit it to generate a temporary
# password automatically and print it once in the terminal.
INITIAL_ADMIN_PASSWORD=
